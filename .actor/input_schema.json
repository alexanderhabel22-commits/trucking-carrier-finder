{
    "title": "Find US trucking companies by cargo, fleet size and location",
    "description": "Pick where, what they haul and how big. The Actor searches the official FMCSA carrier registry, checks each carrier's operating authority, insurance, inspections, crashes and out-of-service orders, and returns one clean list of carriers with phone, address, MC number and safety data.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "states": {
            "title": "States",
            "type": "array",
            "description": "Two-letter state codes. Ignored when you enter a ZIP code below.",
            "editor": "select",
            "items": {
                "type": "string",
                "enum": [
                    "AL",
                    "AK",
                    "AZ",
                    "AR",
                    "CA",
                    "CO",
                    "CT",
                    "DE",
